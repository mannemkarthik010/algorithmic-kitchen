# ── OpenAI API Key (ChefGPT chatbot) ───────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Required for /api/chat to work. Server-side only — never exposed to the browser.
OPENAI_API_KEY=your_openai_api_key_here

# Model used by /api/chat. Falls back to the default below if unset.
# gpt-4o-mini is the recommended default: cheap, fast, and good quality.
OPENAI_MODEL=gpt-4o-mini

# ── Resend API Key (contact form emails) ──────────────────────────
# Sign up free at: https://resend.com
# Free tier: 100 emails/day, 3,000/month
# Steps:
#   1. resend.com → Create API key
#   2. Add your domain (or use onboarding@resend.dev for testing)
#   3. Paste key below
# If left unset, /api/contact logs submissions to the server console instead
# of emailing them — useful for local development without a Resend account.
RESEND_API_KEY=your_resend_api_key_here

# ── Contact destination email ──────────────────────────────────────
# Where contact-form submissions are delivered.
CONTACT_EMAIL=your_contact_email_here

# ── Deployment ────────────────────────────────────────────────────
# Vercel → Project → Settings → Environment Variables
# Add all four keys above, then:
#   vercel --prod
