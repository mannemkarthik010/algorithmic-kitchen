# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore everything except the committed .env.example template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS
__MACOSX
.DS_Store

# LaTeX build artifacts — only resume/resume.tex is tracked, the PDF
# is compiled by CI into public/Karthik_Mannem_Resume.pdf
resume/*.pdf
resume/*.aux
resume/*.log
resume/*.out
resume/*.fls
resume/*.fdb_latexmk
resume/*.synctex.gz
